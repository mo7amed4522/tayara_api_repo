    {
      "name": "Files & Uploads (images / docs)",
      "item": [
        {
          "name": "Upload a file (multipart -> utils/upload OSS)",
          "description": "There is no standalone file route in the repo yet; files are pushed to object storage through `utils/upload.NewOss().UploadFile(file)`, which reads the multipart `file` field and returns `(url, key, err)`.\n\nBody is **multipart/form-data** with a `file` field (the actual binary image/PDF). Point this request at your file-service endpoint. The returned `url` is then used in JSON bodies: `fileUrl` (booking/traveler docs), `coverImageURL` (package), `bannerImageURL` (ad), `headerImg` (profile).",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-token",
                "value": "{{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/files/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [
                    "/path/to/your/image.jpg"
                  ]
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Reference an uploaded URL (example)",
          "description": "Once a file is uploaded to OSS you use its URL inside a JSON body \u2014 e.g. a traveler document. `fileUrl` must be a real OSS URL.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-token",
                "value": "{{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/booking/documents",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": 1,\n  \"documents\": [\n    {\n      \"travelerId\": 1,\n      \"documentTypeId\": 1,\n      \"fileUrl\": \"https://<oss>/path/to/uploaded/passport.jpg\",\n      \"originalName\": \"passport.jpg\",\n      \"mime\": \"image/jpeg\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    }
  ]
}