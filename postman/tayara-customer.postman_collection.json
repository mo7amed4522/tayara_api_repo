{
  "info": {
    "_postman_id": "tayara-customer-0001-0001-0001-000000000001",
    "name": "Tayara - Customer (end-user mobile)",
    "description": "End-user (mobile) API collection. Authenticated calls use the **X-token** header returned by `/api/v1/user/login`.\n\nMoney is in **minor units** (AED fils). Percentages are **basis points** (10000 = 100%).\n\nThe `Files & Uploads` folder shows the platform upload convention driven by `utils/upload` (OSS) \u2014 a `multipart/form-data` request with a `file` field returns a URL that you then place in JSON `fileUrl` / `coverImageURL` fields.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8888"
    },
    {
      "key": "customerToken",
      "value": ""
    }
  ],
