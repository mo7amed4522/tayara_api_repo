            "url": "{{baseUrl}}/api/v1/user/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ahmed Ali\",\n  \"username\": \"ahmed.ali\",\n  \"password\": \"123456\",\n  \"nickName\": \"Ahmed\",\n  \"email\": \"ahmed.ali@mail.test\",\n  \"phoneCountryCode\": \"+971\",\n  \"phone\": \"0561000001\",\n  \"nationality\": \"Emirati\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('customerToken', json.data.token);",
                  "  pm.environment.set('customerToken', json.data.token);",
                  "} else { console.log('login failed', json); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/user/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ahmed.ali\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
