            "url": "{{baseUrl}}/api/v1/system/changePassword",
            "body": { "mode": "raw", "raw": "{\n  \"id\": 1,\n  \"oldPassword\": \"123456\",\n  \"newPassword\": \"newpass123\"\n}", "options": { "raw": { "language": "json" } } }
