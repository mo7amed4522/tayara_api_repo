{
  "info": {
    "_postman_id": "tayara-admin-0003-0003-0003-000000000003",
    "name": "Tayara - Admin (Platform dashboard)",
    "description": "Platform-admin API collection. Authenticated calls use the **S-token** header returned by `/api/v1/system/login`.\n\nMoney is in **minor units** (AED fils). Percentages are **basis points** (10000 = 100%). For image/doc uploads follow the `Files & Uploads` folder convention (multipart `file` -> `utils/upload` OSS URL referenced in JSON bodies).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8888" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/system/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"ops.admin\",\n  \"password\": \"123456\",\n  \"nickName\": \"Ops Admin\",\n  \"headerImg\": \"\",\n  \"email\": \"ops@tayara.test\",\n  \"phoneCountryCode\": \"+971\",\n  \"phone\": \"0500000001\",\n  \"department\": \"Operations\",\n  \"jobTitle\": \"Platform Operator\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('adminToken', json.data.token);",
                  "  pm.environment.set('adminToken', json.data.token);",
                  "} else { console.log('login failed', json); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/system/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@tayara.test\",\n  \"password\": \"123456\"\n}", "options": { "raw": { "language": "json" } } }
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/system/forgot-password",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@tayara.test\"\n}", "options": { "raw": { "language": "json" } } }
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "description": "token comes from the Forgot-Password flow.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/system/reset-password",
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"<reset-token>\",\n  \"newPassword\": \"123456\"\n}", "options": { "raw": { "language": "json" } } }
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "S-token", "value": "{{adminToken}}" }
