    {
      "name": "Files & Uploads (images / docs)",
      "item": [
        {
          "name": "Upload a file (multipart -> utils/upload OSS)",
          "description": "Binary images/PDFs are pushed to object storage via `utils/upload.NewOss().UploadFile(file)`, which reads the multipart `file` field and returns `(url, key, err)`. The returned URL goes into JSON fields (`bannerImageURL`, `fileUrl`, `coverImageURL`).\n\nBody is **multipart/form-data** with a `file` field. For this demo the platform has no standalone file route, so point this at your file-service endpoint.",
          "request": {
            "method": "POST",
            "header": [{ "key": "S-token", "value": "{{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/files/upload",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": ["/path/to/your/banner.jpg"] }]
            }
          },
          "response": []
        }
      ]
